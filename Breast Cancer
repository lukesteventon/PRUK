doses<-doses %>%
  merge(breastcancer, by=c("PSEUDONYMISED_PATIENTID","DRUG_GROUP", "ADMINISTRATION_DATE")) %>% 
  group_by(PSEUDONYMISED_PATIENTID) %>% 
  mutate(cumulativedose_epirubicin=ifelse(DRUG_GROUP=="EPIRUBICIN",cumsum(ACTUAL_DOSE_PER_ADMINISTRATION),NA))%>% 
  mutate(cumulativedose_docetaxel=ifelse(DRUG_GROUP=="DOCETAXEL",cumsum(ACTUAL_DOSE_PER_ADMINISTRATION),NA))%>% 
  mutate(cumulativedose_cyclo=ifelse(DRUG_GROUP=="CYCLOPHOSPHAMIDE",cumsum(ACTUAL_DOSE_PER_ADMINISTRATION),NA))%>% 
  mutate(cumulativedose_FU=ifelse(DRUG_GROUP=="FLUOROURACIL",cumsum(ACTUAL_DOSE_PER_ADMINISTRATION),NA))%>% 
  fill(c(cumulativedose_epirubicin,cumulativedose_docetaxel,cumulativedose_cyclo,cumulativedose_FU),.direction="down") %>% 
  mutate(cumulativedose_FU=ifelse(is.na(cumulativedose_FU),0,cumulativedose_FU)) %>% 
