doses_grouped<-doses %>% 
  #rename(ADMINISTRATION_DATE=ADMINISTRATION_DATE.x) %>% 
  merge(breastcancer, by=c("PSEUDONYMISED_PATIENTID","DRUG_GROUP", "ADMINISTRATION_DATE")) %>% 
  distinct(PSEUDONYMISED_PATIENTID, DRUG_GROUP, ADMINISTRATION_DATE,.keep_all=T) %>% 
  group_by(PSEUDONYMISED_PATIENTID,DRUG_GROUP) %>% 
  mutate(cumulative_dose=sum(ACTUAL_DOSE_PER_ADMINISTRATION)) %>% 
  distinct(PSEUDONYMISED_PATIENTID, DRUG_GROUP,ADMINISTRATION_DATE, cumulative_dose,REGIMEN,.keep_all=T) %>% 
  select(PSEUDONYMISED_PATIENTID, DRUG_GROUP, cumulative_dose,REGIMEN, ADMINISTRATION_DATE, ACTUAL_DOSE_PER_ADMINISTRATION)
#Create table for investigation into BSA and whether patients were capped at 2m^2
